# MoneyMate production settings, read by docker compose from `.env` beside
# docker-compose.yml. Copy this to `.env` and replace every CHANGE_ME.
#
# Generate the secrets on the server, never reuse a development value:
#   openssl rand -hex 32     # POSTGRES_PASSWORD (hex: safe inside a URL)
#   openssl rand -hex 48     # JWT_SECRET
#
# .env is gitignored and never baked into the image (.dockerignore).

# --- database (the `db` container) -----------------------------------------
POSTGRES_USER=moneymate
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=moneymate
# Host loopback port for backups / the one-off data copy over SSH.
DB_HOST_PORT=15432

# --- api -------------------------------------------------------------------
# Rotating this signs every user out.
JWT_SECRET=CHANGE_ME
JWT_EXPIRE_MINUTES=10080
# Host loopback port Caddy proxies to.
API_HOST_PORT=8010
GUNICORN_WORKERS=3
# The calendar the business runs on: what "today" means for attendance.
BUSINESS_TIMEZONE=Asia/Kolkata
# The app is a native client and sends no Origin; "*" only matters for a
# browser. Name real origins here if a web client is ever added.
CORS_ORIGINS=*
