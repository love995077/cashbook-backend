# Production environment for docker compose.
#
#   cp .env.production.example .env.production
#   # fill in every value marked CHANGE ME
#   docker compose --env-file .env.production up -d --build
#
# This file is a template and belongs in version control.
# `.env.production` holds real secrets and MUST NOT be committed — it is
# already covered by .gitignore.
#
# Nothing here is baked into the image: the Dockerfile copies no env file, and
# .dockerignore excludes them from the build context. Values are injected at
# run time by compose.

# --- database ----------------------------------------------------------------
# DB_HOST is set by docker-compose to the `db` service name and is deliberately
# not listed here — setting it to localhost is the classic way to break this.

# The application's own account. It is granted rights to DB_NAME only.
DB_USER=cashbook
DB_PASSWORD=CHANGE_ME_strong_database_password
DB_NAME=cash_book

# MySQL's root password, used to initialise the server and by the healthcheck.
# Different from DB_PASSWORD: the app should never hold root credentials.
MYSQL_ROOT_PASSWORD=CHANGE_ME_different_strong_root_password

# --- auth --------------------------------------------------------------------
# Generate a fresh one per environment. Never reuse the development secret:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Rotating this invalidates every issued token, logging all users out.
JWT_SECRET=CHANGE_ME_generate_a_48_byte_url_safe_secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# --- clients -----------------------------------------------------------------
# Name the real origins. "*" is a development convenience; leaving it here lets
# any website call the API from a browser.
CORS_ORIGINS=https://app.example.com

# --- server ------------------------------------------------------------------
# Each worker keeps its own MySQL connection pool — check the server's
# max_connections before raising this.
GUNICORN_WORKERS=4

# --- voice entry (optional; placeholders until a provider is implemented) ----
STT_PROVIDER=
STT_MODEL=small
LLM_PROVIDER=
LLM_MODEL=
OPENAI_API_KEY=

# --- notifications (optional; placeholder until a provider is implemented) ---
NOTIFICATIONS_ENABLED=false
NOTIFY_PROVIDER=
LARGE_ADVANCE_THRESHOLD=3000
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
