# MySQL connection settings
DB_USER=root
DB_PASSWORD=changeme
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cash_book

# Set to true to echo SQL statements to the console
DB_ECHO=false

# Auth — generate a real secret for anything but local dev:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-insecure-secret-change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Comma-separated list of allowed browser origins, or * for any
CORS_ORIGINS=*

# Voice entry (Phase 6). Both AI steps are placeholders until implemented —
# see app/services/speech_to_text.py and app/services/intent_parser.py.
# Leave empty and /api/voice-entry answers 503 with what to do next.
STT_PROVIDER=          # openai | whisper_local
STT_MODEL=small
LLM_PROVIDER=
LLM_MODEL=
OPENAI_API_KEY=

# Notifications (Phase 8). Placeholder until a provider is implemented in
# app/services/notifications.py. Disabled by default.
NOTIFICATIONS_ENABLED=false
NOTIFY_PROVIDER=          # twilio | whatsapp_cloud
LARGE_ADVANCE_THRESHOLD=3000
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
